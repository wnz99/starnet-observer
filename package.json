{
  "name": "starnet-observer",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone read-only local observer for Herdr, Codex, Claude Code, and llm-bus.",
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.13"
  },
  "scripts": {
    "start": "bun --no-env-file server.js",
    "test": "bun --no-env-file test",
    "presentation": "bun --no-env-file server.js --presentation",
    "validate:themes": "bun --no-env-file scripts/validate-theme-packs.mjs",
    "verify:acceptance": "bun --no-env-file tools/acceptance.ts"
  },
  "bin": {
    "starnet-observer": "server.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wnz99/starnet-observer.git"
  },
  "homepage": "https://github.com/wnz99/starnet-observer#readme",
  "packageManager": "bun@1.3.13"
}
