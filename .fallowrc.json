{
  "duplicates": {
    "threshold": 1
  },
  "entry": [
    "server.{js,ts}",
    "src/sidecar/sqlite/worker.ts",
    "scripts/*.{js,mjs,ts}",
    "frontend/app/theme-pack.{js,ts}",
    "frontend/app/harness.{js,ts}",
    "frontend/app/queryspine.{js,ts}",
    "frontend/app/data-shim.{js,ts}",
    "frontend/js/sprite-load-plan.{js,ts}",
    "frontend/js/assets.{js,ts}",
    "frontend/app/observer-model.{js,ts}",
    "frontend/app/observer-scene.{js,ts}",
    "frontend/app/observer-mail.{js,ts}",
    "frontend/app/observer-inspector.{js,ts}",
    "frontend/app/observer-mail-inspector.{js,ts}",
    "frontend/app/scene-art-roles.{js,ts}",
    "frontend/app/observer-office-art.{js,ts}",
    "frontend/app/observer-view.{js,ts}",
    "frontend/app/observer.{js,ts}",
    "**/*.test.{js,ts}",
    "eslint.config.mjs",
    "tools/acceptance.ts",
    "tools/quality/isolate-typescript.mjs",
    "frontend/css/observer.css",
    "tools/build.ts"
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.venv/**",
    "**/.nx/**",
    "**/package-staging/**"
  ]
}
