{
  "duplicates": {
    "threshold": 1
  },
  "entry": [
    "server.{js,ts}",
    "src/sidecar/sqlite/worker.ts",
    "scripts/*.{js,mjs,ts}",
    "frontend/app/observer-scene.{js,ts}",
    "frontend/app/observer-view.{js,ts}",
    "frontend/app/observer.{js,ts}",
    "**/*.test.{js,ts}",
    "eslint.config.mjs",
    "tools/acceptance.ts",
    "tools/quality/isolate-typescript.mjs",
    "frontend/css/observer.css",
    "tools/build.ts",
    "src/browser/prepaint.ts",
    "src/browser/legacy-bridge.ts"
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.venv/**",
    "**/.nx/**",
    "**/package-staging/**"
  ]
}
