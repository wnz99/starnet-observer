{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "types": ["bun"],
    "allowJs": false,
    "rootDir": ".",
    "outDir": "dist/runtime"
  },
  "include": [
    "src/sidecar/**/*.ts",
    "src/server/runtime-paths.ts",
    "src/shared/**/*.ts",
    "scripts/stream.ts"
  ],
  "exclude": ["**/*.test.ts", "**/*.fixture.ts"],
  "files": ["src/sidecar/sqlite/worker.ts"]
}
